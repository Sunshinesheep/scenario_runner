import basic.osc

type acceleration is SI(m: 1, s: -2)
unit kphps               of acceleration is SI(m: 1, s: -1, factor: 0.277777778)

scenario top:
    path: Path                      # A path in the map
    path.set_map("Town04")    # specify map to use in this test
    path.path_min_driving_lanes(2)         # Path should have at least two lanes

    ego_vehicle: Model3                # ego car
    npc: Rubicon               # The other car
    npc2: Model3

    event start
    do serial:
        get_ahead: parallel(duration: 15s):
            ego_vehicle.drive(path) with:
                lane(2, at: start)
                speed(60kph)
            npc.drive(path) with:
                set_behavior_model(behavior_type: AI, model: Interfuser, hyperparameters: "max_speed=20, max_acc=5")
                speed(30kph)
                set_behavior_logic(
                    lane:"1, at:start",
                    position:"15, behind:ego_vehicle, at:start",
                    lane:"2, right_of: ego_vehicle, at:end",
                    position:"20, ahead_of:ego_vehicle, at:end"
                )
                set_behavior_logic(
                    lane_s: 1
                    position_s:"15, behind:ego_vehicle"
                    lane_e: 2
                    position_e:"20, ahead_of:ego_vehicle"
                )
                #lane(right_of: ego_vehicle, at: start)
                #position(20m, behind: ego_vehicle, at: start)
        #next: parallel(duration: 15s):
            #ego_vehicle.drive(path) with:
                #speed(10kph)
            #npc.drive(path) with:
                #speed(80kph)
