import basic.osc

global path: Path
global my_map: string = "Town04"
global min_lane: int = 2

scenario top:
    path.set_map(my_map)
    path.path_min_driving_lanes(min_lane)
    initial_bm: string
    ego_vehicle: Model3
    npc1: Rubicon
    npc2: Rubicon
    event start
    event end

    do serial:
        initial_phase: parallel(duration: 10s):
            ego_vehicle.drive() with:
                # keep(initial_bm == user_agent_AI)
                speed([50kph..120kph])
                lane(1, at: start)
            # ego_vehicle.bm_user_hyperparameters(aggressiveness: 0.8)
            npc1.drive() with:
                # keep(initial == IDM)
                speed([50kph..120kph])
                lane(1, at: start)
                position([5m..10m], ahead_of: ego_vehicle, at: start)
            # npc1.bm_user_hyperparameters(aggressiveness: 0.2)
            npc2.drive() with:
                # keep(initial == IDM)
                lateral([5m..10m], right_of: ego_vehicle)
                speed([50kph..120kph])
            # npc2.bm_user_hyperparameters(aggressiveness: 0.2)
        lane_change_phase: parallel(duration: 30s):
            ego_vehicle.drive() with:
                # keep(initial_bm == user_agent_AI)
                lane(1)
            npc1.drive() with:
                # keep(initial == IDM)
                lane(1)
            # on(distance_to_vehicle: ego_vehicle) < 5m
            # npc2.set_bm_AI(cut_inAI)
            # npc2.bm_user_hyperparameters(0.8)
            # npc2.bm_input_parameters()             #AI输入，参考carla_leadboard
            # npc2.bm_target_logic_scenario(lateral([5m..10m], left_of: ego_vehicle, at: start)，
            # position([5m..10m], ahead_of: ego_vehicle, at: end))        #指导,给AI
            # npc2.bm_transition(smooth1, max_acceleration_change: 1.0mpss, max_velocity_change: 0.5mps)

        post_lane_change: parallel(duration: 10s):
            ego_vehicle.drive() with:
                # keep(initial_bm == user_agent_AI)
                lane(1)
            npc1.drive() with:
                # keep(initial_bm == IDM)
                lane(1)
                speed([50kph..120kph])
            npc2.drive() with:
                # keep(initial_bm == cut_inAI)
                position([5m..15m], ahead_of: ego_vehicle)
