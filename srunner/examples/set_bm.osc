import basic.osc

scenario top:
    path: Path                      # A path in the map
    path.set_map("Town04")
    path.path_min_driving_lanes(3)

    ego_vehicle: Model3                # ego car
    npc: Rubicon               # The other car

    event start
    event end

    do serial:
        get_ahead: parallel(duration: 9s):
            ego_vehicle.drive(path) with:
                lane(2, at: start)
                set_behavior_model(behavior_type: "AI", model: "interfuser", hyperparameters: "max_speed=20, max_acc=5")
                # speed(20kph)
            npc.drive(path) with:
                lane(right_of: ego_vehicle, at: start)
                position(10m, behind: ego_vehicle, at: start)
                position(25m, ahead_of: ego_vehicle, at: end)

        change_lane: parallel(duration: 5s):
            ego_vehicle.drive(path) with:
                set_behavior_model(behavior_type: "AI", model: "interfuser", hyperparameters: "max_speed=20, max_acc=5")
            npc.drive(path) with:
                change_lane(lane_changes: 1, side: left)

        slow: parallel(duration: 20s):
            ego_vehicle.drive(path) with:
                set_behavior_model(behavior_type: "AI", model: "interfuser", hyperparameters: "max_speed=20, max_acc=5")
            npc.drive(path) with:
                speed(20kph)
